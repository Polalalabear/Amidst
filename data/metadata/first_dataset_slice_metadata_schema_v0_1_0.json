{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amidst.first-dataset-slice.metadata/0.1.0",
  "title": "Amidst First Dataset Slice Metadata",
  "description": "CONFIRMED authoritative per-sample ground-truth contract. image_gt.png is optional and never authoritative by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "dataset_version",
    "contract_version",
    "generation_run_id",
    "scene",
    "sample_id",
    "frame_id",
    "artifacts",
    "camera",
    "ground_truth",
    "tasks",
    "validity",
    "provenance"
  ],
  "properties": {
    "schema_name": {"const": "amidst.first_dataset_slice_metadata"},
    "schema_version": {"const": "0.1.0"},
    "dataset_version": {"const": "school_v1_first_slice_v0_1_0"},
    "contract_version": {"const": "amidst.school.first-dataset-slice/0.1.0"},
    "generation_run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "scene_version",
        "source_scene",
        "source_scene_sha256",
        "output_scene",
        "output_scene_sha256"
      ],
      "properties": {
        "scene_id": {"const": "school"},
        "scene_version": {"const": "v1"},
        "source_scene": {"const": "school_v1.blend"},
        "source_scene_sha256": {"$ref": "#/$defs/sha256"},
        "output_scene": {"type": "string", "minLength": 1},
        "output_scene_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sample_id": {"type": "string", "pattern": "^school_v1_first_slice_v0_1_0_frame_[0-9]{6}$"},
    "frame_id": {"type": "string", "pattern": "^frame_[0-9]{6}$"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_observation", "metadata", "ground_truth_visualization"],
      "properties": {
        "raw_observation": {"const": "image.png"},
        "metadata": {"const": "metadata.json"},
        "ground_truth_visualization": {
          "oneOf": [
            {"const": "image_gt.png"},
            {"type": "null"}
          ]
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "pose", "intrinsics"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/instance_id"},
        "pose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "world_coordinate_frame",
            "camera_coordinate_frame",
            "position_world_m",
            "matrix_world",
            "world_to_camera_cv"
          ],
          "properties": {
            "world_coordinate_frame": {"const": "blender_world_metric_scale_1"},
            "camera_coordinate_frame": {"const": "camera_cv"},
            "position_world_m": {"$ref": "#/$defs/vector3"},
            "matrix_world": {"$ref": "#/$defs/matrix4"},
            "world_to_camera_cv": {"$ref": "#/$defs/matrix4"}
          }
        },
        "intrinsics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection_type",
            "lens_mm",
            "sensor_width_mm",
            "sensor_height_mm",
            "sensor_fit",
            "shift_x",
            "shift_y",
            "clip_start_m",
            "clip_end_m",
            "fov_x_radians",
            "fov_y_radians",
            "render_width_px",
            "render_height_px"
          ],
          "properties": {
            "projection_type": {"const": "PERSP"},
            "lens_mm": {"type": "number", "exclusiveMinimum": 0},
            "sensor_width_mm": {"type": "number", "exclusiveMinimum": 0},
            "sensor_height_mm": {"type": "number", "exclusiveMinimum": 0},
            "sensor_fit": {"enum": ["AUTO", "HORIZONTAL", "VERTICAL"]},
            "shift_x": {"type": "number"},
            "shift_y": {"type": "number"},
            "clip_start_m": {"type": "number", "exclusiveMinimum": 0},
            "clip_end_m": {"type": "number", "exclusiveMinimum": 0},
            "fov_x_radians": {"type": "number", "exclusiveMinimum": 0},
            "fov_y_radians": {"type": "number", "exclusiveMinimum": 0},
            "render_width_px": {"const": 1920},
            "render_height_px": {"const": 1080}
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_instance_ids", "objects", "relative_spatial_relationships"],
      "properties": {
        "visible_instance_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/instance_id"}
        },
        "objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/object_ground_truth"}
        },
        "relative_spatial_relationships": {
          "type": "array",
          "items": {"$ref": "#/$defs/relation_ground_truth"}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/visible_objects_task"},
          {"$ref": "#/$defs/nearest_object_task"},
          {"$ref": "#/$defs/distance_to_object_task"},
          {"$ref": "#/$defs/relation_task"}
        ]
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "invalidation_reasons", "validation_checks"],
      "properties": {
        "status": {"enum": ["valid", "invalid", "needs_review"]},
        "invalidation_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/invalidation_reason"}
        },
        "validation_checks": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "valid"}}},
          "then": {"properties": {"invalidation_reasons": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["invalid", "needs_review"]}}},
          "then": {"properties": {"invalidation_reasons": {"minItems": 1}}}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_registry",
        "instance_registry_sha256",
        "identity_policy_id",
        "semantic_annotation_version",
        "task_contract_version",
        "spatial_conventions_version",
        "visibility_definition_version",
        "render_config_version",
        "render_resource_policy_id",
        "resource_policy",
        "authoritative_visual_fidelity",
        "resource_manifest",
        "resource_manifest_sha256",
        "generator_version",
        "blender_version",
        "blender_build_hash",
        "sample_seed_hex"
      ],
      "properties": {
        "instance_registry": {"const": "data/annotations/instance_registry/school.json"},
        "instance_registry_sha256": {"$ref": "#/$defs/sha256"},
        "identity_policy_id": {"const": "amidst.school.object-id/1.0.1"},
        "semantic_annotation_version": {"const": "school.v1.semantic/0.1.0"},
        "task_contract_version": {"const": "amidst.school.first-dataset-slice/0.1.0"},
        "spatial_conventions_version": {"const": "amidst.school.first-slice-spatial/1.0.0"},
        "visibility_definition_version": {"const": "amidst.school.first-slice-visibility/1.0.0"},
        "render_config_version": {"const": "amidst.school.first-slice-render/0.1.0"},
        "render_resource_policy_id": {"const": "amidst.school.texture-agnostic-render/0.1.0"},
        "resource_policy": {"const": "texture_agnostic"},
        "authoritative_visual_fidelity": {"const": false},
        "resource_manifest": {"type": "string", "minLength": 1},
        "resource_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "generator_version": {"type": "string", "minLength": 1},
        "blender_version": {"const": "5.2.1 LTS"},
        "blender_build_hash": {"const": "9e2066aef7ef"},
        "sample_seed_hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instance_id": {"type": "string", "pattern": "^amidst:school:object:[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "matrix4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {"type": "number"}
      }
    },
    "invalidation_reason": {
      "enum": [
        "checksum_mismatch",
        "stable_id_mismatch",
        "invalid_camera",
        "missing_or_unapproved_required_resource",
        "non_finite_geometry_or_camera_value",
        "object_not_task_eligible",
        "insufficient_visible_pixels",
        "relation_within_deadband",
        "unsupported_photometric_visibility",
        "render_ground_truth_mismatch",
        "contract_or_provenance_mismatch",
        "generation_failure"
      ]
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible_pixel_count",
        "total_projected_pixel_count",
        "occluded_pixel_count",
        "occlusion_fraction",
        "occlusion_state"
      ],
      "properties": {
        "visible_pixel_count": {"type": "integer", "minimum": 0},
        "total_projected_pixel_count": {"type": "integer", "minimum": 0},
        "occluded_pixel_count": {"type": "integer", "minimum": 0},
        "occlusion_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "occlusion_state": {"enum": ["not_projected", "fully_occluded", "partially_occluded", "unoccluded"]}
      }
    },
    "object_ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "object_type",
        "anchor_world_m",
        "anchor_camera_m",
        "distance_m",
        "visibility"
      ],
      "properties": {
        "instance_id": {"$ref": "#/$defs/instance_id"},
        "object_type": {"enum": ["CURVE", "FONT", "MESH"]},
        "anchor_world_m": {"$ref": "#/$defs/vector3"},
        "anchor_camera_m": {"$ref": "#/$defs/vector3"},
        "distance_m": {"type": "number", "minimum": 0},
        "visibility": {"$ref": "#/$defs/visibility"}
      }
    },
    "relation_ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_instance_id",
        "relation",
        "object_instance_id",
        "coordinate_frame",
        "axis_delta_m",
        "tolerance_m",
        "derivation"
      ],
      "properties": {
        "subject_instance_id": {"$ref": "#/$defs/instance_id"},
        "relation": {"enum": ["left_of", "right_of", "in_front_of", "behind"]},
        "object_instance_id": {"$ref": "#/$defs/instance_id"},
        "coordinate_frame": {"const": "camera_cv"},
        "axis_delta_m": {"type": "number"},
        "tolerance_m": {"const": 0.0001},
        "derivation": {"const": "Blender_geometry"}
      }
    },
    "question": {"type": ["string", "null"]},
    "visible_objects_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "inputs", "authoritative_answer", "question"],
      "properties": {
        "task": {"const": "visible_objects"},
        "inputs": {"type": "object", "maxProperties": 0},
        "authoritative_answer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["instance_ids"],
              "properties": {"instance_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/instance_id"}}}
            },
            {"type": "null"}
          ]
        },
        "question": {"$ref": "#/$defs/question"}
      }
    },
    "nearest_object_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "inputs", "authoritative_answer", "question"],
      "properties": {
        "task": {"const": "nearest_object"},
        "inputs": {"type": "object", "maxProperties": 0},
        "authoritative_answer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["selected_instance_id", "distance_m", "tie_instance_ids"],
              "properties": {
                "selected_instance_id": {"$ref": "#/$defs/instance_id"},
                "distance_m": {"type": "number", "minimum": 0},
                "tie_instance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/instance_id"}}
              }
            },
            {"type": "null"}
          ]
        },
        "question": {"$ref": "#/$defs/question"}
      }
    },
    "distance_to_object_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "inputs", "authoritative_answer", "question"],
      "properties": {
        "task": {"const": "distance_to_object"},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance_id"],
          "properties": {"instance_id": {"$ref": "#/$defs/instance_id"}}
        },
        "authoritative_answer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["instance_id", "distance_m"],
              "properties": {
                "instance_id": {"$ref": "#/$defs/instance_id"},
                "distance_m": {"type": "number", "minimum": 0}
              }
            },
            {"type": "null"}
          ]
        },
        "question": {"$ref": "#/$defs/question"}
      }
    },
    "relation_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "inputs", "authoritative_answer", "question"],
      "properties": {
        "task": {"enum": ["left_of", "right_of", "in_front_of", "behind"]},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_instance_id", "object_instance_id"],
          "properties": {
            "subject_instance_id": {"$ref": "#/$defs/instance_id"},
            "object_instance_id": {"$ref": "#/$defs/instance_id"}
          }
        },
        "authoritative_answer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["result", "axis_delta_m", "tolerance_m"],
              "properties": {
                "result": {"type": "boolean"},
                "axis_delta_m": {"type": "number"},
                "tolerance_m": {"const": 0.0001}
              }
            },
            {"type": "null"}
          ]
        },
        "question": {"$ref": "#/$defs/question"}
      }
    }
  }
}
